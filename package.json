{
  "name": "dsh-screenshot",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness 截图插件：点击输入框「＋」选截图，框选后图片直接进入会话输入框（含隐藏本窗口）。",
  "type": "module",
  "main": "plugins/dsh-screenshot/lib/entry.js",
  "exports": {
    ".": "./plugins/dsh-screenshot/lib/entry.js",
    "./client": "./plugins/dsh-screenshot/lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
